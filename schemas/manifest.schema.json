{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phennyxz/covil-game-spec/blob/main/schemas/manifest.schema.json",
  "title": "COVIL manifest 0.1 experimental subset — ADR 0007",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "entry",
    "runtime",
    "display",
    "input",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9_./-]+\\.html$"
    },
    "runtime": {
      "const": "web"
    },
    "display": {
      "type": "object",
      "required": [
        "mode",
        "orientation",
        "aspectRatio"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "emulator",
            "mobile",
            "adaptive"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "any"
          ]
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityId"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityId"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "languages",
        "genres",
        "tags",
        "ageRating",
        "content"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        },
        "genres": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 40
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 40
          }
        },
        "ageRating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "value",
            "status"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "status": {
              "enum": [
                "self_declared",
                "official",
                "unknown"
              ]
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "violence",
            "userInteraction",
            "advertising",
            "inAppPurchases"
          ],
          "properties": {
            "violence": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "userInteraction": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "advertising": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "inAppPurchases": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capabilityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
    }
  },
  "$comment": "Cross-array disjointness is checked by the validator; JSON Schema 2020-12 cannot directly compare array members across properties."
}
