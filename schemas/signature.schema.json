{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covil.dev/schemas/signature.schema.json",
  "title": "COVIL VLG developer signature envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "signature"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^ed25519-sha256:[0-9a-f]{64}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
